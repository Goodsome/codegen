        "allow_concurrent_runs": false
    },
    {
        "label": "CLI: Get Component",
        "command": "uv run codegen get-component code_metadata $ZED_SELECTED_TEXT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false
    }
