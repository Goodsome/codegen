{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codegen Configuration Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the project."
    },
    "layout": {
      "type": "string",
      "description": "The layout strategy to use for file generation."
    },
    "description": {
      "type": "string",
      "description": "A description of the project."
    },
    "contexts": {
      "type": "array",
      "items": { "$ref": "#/definitions/ContextSpec" }
    },
    "bootstrap": { "$ref": "#/definitions/BootstrapSpec" }
  },
  "required": ["name", "contexts"],
  "definitions": {
    "ContextSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "domain": { "$ref": "#/definitions/DomainSpec" },
        "application": { "$ref": "#/definitions/ApplicationSpec" },
        "infrastructure": { "$ref": "#/definitions/InfrastructureSpec" }
      },
      "required": ["name"]
    },
    "DomainSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggregates": {
          "type": "array",
          "items": { "$ref": "#/definitions/ClassSpec" }
        },
        "value_objects": {
          "type": "array",
          "items": { "$ref": "#/definitions/ClassSpec" }
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/definitions/ServiceSpec" }
        },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/definitions/PortSpec" }
        },
        "enums": {
          "type": "array",
          "items": { "$ref": "#/definitions/EnumSpec" }
        }
      }
    },
    "ApplicationSpec": {
      "type": "object",
      "properties": {
        "use_cases": {
          "type": "array",
          "items": { "$ref": "#/definitions/UseCase" }
        }
      }
    },
    "InfrastructureSpec": {
      "type": "object",
      "properties": {
        "adapters": {
          "type": "array",
          "items": { "$ref": "#/definitions/ClassSpec" }
        }
      }
    },
    "BootstrapSpec": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "array",
          "items": { "$ref": "#/definitions/BindingSpec" }
        },
        "options": { "$ref": "#/definitions/BootstrapOptions" }
      }
    },
    "BindingSpec": {
      "type": "object",
      "properties": {
        "port": { "type": "string" },
        "implementation": { "type": "string" }
      }
    },
    "BootstrapOptions": {
      "type": "object",
      "properties": {
        "dry_run": { "type": "boolean" },
        "overwrite": { "type": "boolean" }
      }
    },
    "Attribute": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "type"]
    },
    "MethodSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/Attribute" }
        },
        "output": {
          "type": "object",
          "properties": {
            "type": { "type": "string" }
          },
          "required": ["type"]
        }
      },
      "required": ["name"]
    },
    "ClassSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "implements": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/Attribute" }
        },
        "behaviors": {
          "type": "array",
          "items": { "$ref": "#/definitions/MethodSpec" }
        },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/definitions/MethodSpec" }
        }
      },
      "required": ["name"]
    },
    "ServiceSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/definitions/MethodSpec" }
        }
      },
      "required": ["name"]
    },
    "PortSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "kind": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/definitions/MethodSpec" }
        }
      },
      "required": ["name"]
    },
    "EnumSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "members": {
          "type": "array",
          "items": { "$ref": "#/definitions/EnumMemberSpec" }
        }
      },
      "required": ["name"]
    },
    "EnumMemberSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["name"]
    },
    "UseCase": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["command", "query"] },
        "description": { "type": "string" },
        "command": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "attributes": {
              "type": "array",
              "items": { "$ref": "#/definitions/Attribute" }
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "attributes": {
              "type": "array",
              "items": { "$ref": "#/definitions/Attribute" }
            }
          }
        }
      },
      "required": ["name"]
    }
  }
}
